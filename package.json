{
  "name": "marriage",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @marriage/server --filter @marriage/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky",
    "deploy": "pnpm --filter @marriage/web build && pnpm --filter @marriage/server run deploy",
    "preview": "pnpm --filter @marriage/web build && pnpm --filter @marriage/server exec wrangler dev"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
